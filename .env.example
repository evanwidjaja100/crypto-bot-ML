# Bybit API credentials — never commit a real .env
BYBIT_API_KEY=
BYBIT_API_SECRET=
# true -> Bybit testnet/demo, false -> mainnet (live)
BYBIT_TESTNET=true

# Runtime mode: backtest | paper | testnet | live
# (live is refused unless BOT_LIVE_CONFIRM matches the phrase in config/settings.yaml)
BOT_MODE=paper
BOT_LIVE_CONFIRM=

# Optional overrides; defaults come from config/settings.yaml
DATA_DIR=./data
LOG_LEVEL=INFO
